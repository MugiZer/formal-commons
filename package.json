{
  "name": "ohara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "registry:build": "tsx scripts/build-registry.ts",
    "schema": "tsx scripts/schema.ts",
    "lean:check": "tsx scripts/check-lean.ts",
    "approve": "tsx scripts/approve.ts",
    "links:check": "tsx scripts/check-links.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build": "npm run registry:build && astro build --root site",
    "dev": "npm run build && wrangler dev",
    "dev:site": "astro dev --root site",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-pro": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@primer/octicons-react": "19.42.0",
    "@tailwindcss/vite": "4.3.3",
    "agents": "0.30.1",
    "astro": "7.4.2",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.152.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
