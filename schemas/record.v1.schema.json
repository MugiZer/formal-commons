{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "kind": {
      "type": "string",
      "enum": [
        "specification",
        "theorem",
        "behavioral_model",
        "verified_component",
        "project"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
    },
    "tags": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "proof_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "statement": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "path",
        "symbol",
        "statement"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        }
      },
      "required": [
        "spdx",
        "url",
        "attribution"
      ],
      "additionalProperties": false
    },
    "owners": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
      }
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "reuse": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
    },
    "project_details": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "maintenance",
            "archived",
            "unknown"
          ]
        },
        "issues": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "contributing": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "opportunities": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
          }
        }
      },
      "required": [
        "status",
        "issues",
        "contributing",
        "opportunities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "record_version",
    "kind",
    "title",
    "summary",
    "tags",
    "proof_system",
    "source",
    "assumptions",
    "limitations",
    "license",
    "owners",
    "project",
    "updated",
    "reuse"
  ],
  "additionalProperties": false
}
