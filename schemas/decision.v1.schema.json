{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "record_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publication": {
      "type": "string",
      "enum": [
        "proposed",
        "under_review",
        "accepted",
        "withdrawn"
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        }
      },
      "required": [
        "by",
        "date",
        "url",
        "notes"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pinned",
            "stale",
            "unknown"
          ]
        },
        "checked": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        }
      },
      "required": [
        "status",
        "checked",
        "notes"
      ],
      "additionalProperties": false
    },
    "mechanical": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_checked_by_us",
            "upstream_reported",
            "checked_at_pinned_revision"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "url": {
                  "type": "string",
                  "maxLength": 500,
                  "format": "uri"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                }
              },
              "required": [
                "by",
                "date",
                "url",
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "checker": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "axioms": {
          "anyOf": [
            {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reports": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "upstream",
                  "ohara",
                  "community"
                ]
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "inconclusive"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "reference": {
                "type": "object",
                "properties": {
                  "by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 500,
                    "format": "uri"
                  },
                  "notes": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                  }
                },
                "required": [
                  "by",
                  "date",
                  "url",
                  "notes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "origin",
              "result",
              "scope",
              "source_revision",
              "reference"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "reference",
        "checker",
        "source_revision",
        "proof_digest",
        "axioms"
      ],
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "maintainer_reviewed",
            "qualified_expert_reviewed"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "url": {
                  "type": "string",
                  "maxLength": 500,
                  "format": "uri"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                }
              },
              "required": [
                "by",
                "date",
                "url",
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reference",
        "qualification"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "claimed",
            "independently_evidenced"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "url": {
                  "type": "string",
                  "maxLength": 500,
                  "format": "uri"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
                }
              },
              "required": [
                "by",
                "date",
                "url",
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$"
        }
      },
      "required": [
        "status",
        "reference",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "record_version",
    "record_digest",
    "publication",
    "approval",
    "freshness",
    "mechanical",
    "semantic",
    "implementation"
  ],
  "additionalProperties": false
}
