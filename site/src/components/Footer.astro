---
import snapshot from '../../../generated/catalogue.json';
---
<footer class="snapshot"><a href="/registry.json">Snapshot <code>{snapshot.snapshot_id.slice(0, 12)}</code></a><span>Source <code>{snapshot.source_commit.slice(0, 12)}</code></span></footer>
<style>.snapshot { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3); font-size: .8rem; overflow-wrap: anywhere; }</style>
