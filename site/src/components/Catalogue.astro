---
import snapshot from '../../../generated/catalogue.json';
import type { Catalogue } from '../../../registry/schema';
import { latestRecords, discoverable } from '../../../mcp/catalogue';
const { mode = 'artifacts' } = Astro.props;
const records = latestRecords(snapshot as Catalogue)
  .filter((r) => discoverable(r) && (mode === 'all' || (mode === 'projects' ? r.kind === 'project' : r.kind !== 'project')))
  .sort((a, b) => Number(a.kind === 'project') - Number(b.kind === 'project'));
const proofSystems = [...new Set(records.map((r) => r.proof_system))].sort();
---
<section class="not-content" data-catalogue aria-label={mode === 'projects' ? 'Project catalogue' : mode === 'all' ? 'Knowledge catalogue' : 'Artifact catalogue'}>
  <form class="filters" role="search">
    <div class="filter-fields">
      <label class="query">Search records<input type="search" name="query" placeholder={mode === 'projects' ? 'kernel, semantics' : mode === 'all' ? 'filter, Lean, kernel' : 'filter, membership'} maxlength="256" /></label>
      <label>Proof system<select name="proof"><option value="">All systems</option>{proofSystems.map((system) => <option>{system}</option>)}</select></label>
      <label>Check status<select name="evidence"><option value="">All checks</option><option value="checked_at_pinned_revision">Checked revision</option><option value="upstream_reported">Upstream report</option><option value="not_checked_by_us">Not checked</option></select></label>
    </div>
    <div class="catalogue-toolbar">
      <p class="catalogue-count" aria-live="polite" aria-atomic="true">{records.length} {records.length === 1 ? 'record' : 'records'}</p>
      <button type="reset">Clear filters</button>
    </div>
  </form>
  <noscript><p>Filtering needs JavaScript. All records are listed below.</p></noscript>
  <div class="record-list">
    {records.map((record) => <article class="record-row" data-record data-search={[record.id, record.title, record.title.replaceAll(' — ', ': '), record.source.symbol ?? '', record.source.statement ?? '', record.summary, record.proof_system, ...record.tags].join(' ').toLowerCase()} data-proof={record.proof_system} data-evidence={record.evidence.mechanical.status}>
      <div class="record-body">
        <div class="record-meta"><span>{record.kind.replaceAll('_', ' ')}</span>{' '}<span>{record.proof_system}</span></div>
        <h2><a href={`/records/${record.id}/${record.record_digest}/`}>{record.source.symbol ? <code>{record.source.symbol}</code> : record.title.replaceAll(' — ', ': ')}</a></h2>
        {record.source.statement && <p class="record-statement"><code>{record.source.statement}</code></p>}
        <p>{record.summary}</p>
      </div>
      <dl class="record-evidence">
        <div><dt>Check</dt><dd>{record.evidence.mechanical.status.replaceAll('_', ' ')}</dd></div>
        <div><dt>Human review</dt><dd>{record.evidence.semantic.status.replaceAll('_', ' ')}</dd></div>
        <div><dt>Correspondence</dt><dd>{record.evidence.implementation.status.replaceAll('_', ' ')}</dd></div>
      </dl>
    </article>)}
  </div>
  <p data-empty hidden>No records match. Clear the filters or <a href="/contribute/">propose a record</a>.</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-catalogue]').forEach((catalogue) => {
    const form = catalogue.querySelector<HTMLFormElement>('form')!;
    const rows = [...catalogue.querySelectorAll<HTMLElement>('[data-record]')];
    const update = () => {
      const values = new FormData(form);
      const query = String(values.get('query')).trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      rows.forEach((row) => {
        row.hidden = !(query.every((token) => row.dataset.search!.includes(token)) && (!values.get('proof') || row.dataset.proof === values.get('proof')) && (!values.get('evidence') || row.dataset.evidence === values.get('evidence')));
        if (!row.hidden) count++;
      });
      catalogue.querySelector('.catalogue-count')!.textContent = `${count} ${count === 1 ? 'record' : 'records'}`;
      catalogue.querySelector<HTMLElement>('[data-empty]')!.hidden = count !== 0;
    };
    form.addEventListener('input', update);
    // Reset fires before the browser restores field values.
    form.addEventListener('reset', () => requestAnimationFrame(update));
    form.addEventListener('submit', (event) => event.preventDefault());
  });
</script>
