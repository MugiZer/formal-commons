---
import snapshot from '../../../generated/catalogue.json';
import type { Catalogue } from '../../../registry/schema';
import { latestRecords, discoverable } from '../../../mcp/catalogue';
const { mode = 'artifacts' } = Astro.props;
const records = latestRecords(snapshot as Catalogue).filter((r) => discoverable(r) && (mode === 'projects' ? r.kind === 'project' : r.kind !== 'project'));
const proofSystems = [...new Set(records.map((r) => r.proof_system))].sort();
---
<section data-catalogue aria-label={mode === 'projects' ? 'Project catalogue' : 'Artifact catalogue'}>
  <form class="filters" role="search">
    <label class="query">Behavior or keyword<input type="search" name="query" placeholder={mode === 'projects' ? 'Try kernel or semantics' : 'Try filter or membership'} maxlength="256" /></label>
    <label>Proof system<select name="proof"><option value="">All systems</option>{proofSystems.map((system) => <option>{system}</option>)}</select></label>
    <label>Mechanical evidence<select name="evidence"><option value="">All evidence</option><option value="checked_at_pinned_revision">Checked at pinned revision</option><option value="upstream_reported">Upstream reported</option><option value="not_checked_by_us">Not checked by us</option></select></label>
  </form>
  <p class="catalogue-count" aria-live="polite" aria-atomic="true">{records.length} {records.length === 1 ? 'record' : 'records'}</p>
  <div class="record-list">
    {records.map((record) => <article class="record-row" data-record data-search={`${record.title} ${record.source.symbol ?? ''} ${record.summary} ${record.tags.join(' ')}`.toLowerCase()} data-proof={record.proof_system} data-evidence={record.evidence.mechanical.status}>
      <div class="record-meta"><span>{record.kind.replaceAll('_', ' ')}</span><span>{record.proof_system}</span><span>v{record.record_version}</span></div>
      <h2><a href={`/records/${record.id}/${record.record_digest}/`}>{record.title}</a></h2>
      {record.source.symbol && <p class="record-symbol"><code>{record.source.symbol}</code></p>}
      <p>{record.summary}</p>
      <div class="record-tags">{record.tags.map((tag) => <span>{tag}</span>)}</div>
      <p class="evidence-line"><strong>{record.evidence.mechanical.status.replaceAll('_', ' ')}</strong> · Semantic: {record.evidence.semantic.status.replaceAll('_', ' ')} · Correspondence: {record.evidence.implementation.status.replaceAll('_', ' ')}</p>
    </article>)}
  </div>
  <p data-empty hidden>No records match these filters. Try a broader behavior or <a href="/contribute/">propose an artifact</a>.</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-catalogue]').forEach((catalogue) => {
    const form = catalogue.querySelector<HTMLFormElement>('form')!;
    const rows = [...catalogue.querySelectorAll<HTMLElement>('[data-record]')];
    const update = () => {
      const values = new FormData(form);
      const query = String(values.get('query')).trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      rows.forEach((row) => {
        row.hidden = !(query.every((token) => row.dataset.search!.includes(token)) && (!values.get('proof') || row.dataset.proof === values.get('proof')) && (!values.get('evidence') || row.dataset.evidence === values.get('evidence')));
        if (!row.hidden) count++;
      });
      catalogue.querySelector('.catalogue-count')!.textContent = `${count} ${count === 1 ? 'record' : 'records'}`;
      catalogue.querySelector<HTMLElement>('[data-empty]')!.hidden = count !== 0;
    };
    form.addEventListener('input', update);
    form.addEventListener('submit', (event) => event.preventDefault());
  });
</script>
