{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./site/src/*"] },
    "types": ["node"]
  },
  "include": ["registry/**/*.ts", "scripts/**/*.ts", "mcp/**/*.ts", "community/**/*.ts", "site/src/**/*.tsx", "site/src/lib/**/*.ts", "tests/**/*.ts"]
}
